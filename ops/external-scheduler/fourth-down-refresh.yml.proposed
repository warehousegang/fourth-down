name: Refresh Fourth Down
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: fourth-down-refresh
  cancel-in-progress: false
jobs:
  refresh:
    if: github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    permissions:
      contents: write
      pages: write
    env:
      PYTHONDONTWRITEBYTECODE: '1'
      VITE_BASE_PATH: /fourth-down/
    steps:
      - name: Checkout the current portfolio
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          path: portfolio
          ref: main
          persist-credentials: true
      - name: Checkout reviewed Fourth Down source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: warehousegang/fourth-down
          ref: REVIEWED_V1_COMMIT_REQUIRED_BEFORE_ACTIVATION
          path: source
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: '3.14.2'
      - name: Install pinned Python dependencies
        working-directory: source
        run: python -m pip install -r requirements.txt -r requirements-results.txt -c requirements-lock.txt
      - name: Restore evidence and check for a due refresh
        id: refresh
        working-directory: source
        run: |
          python scripts/automated_refresh.py prepare --portfolio ../portfolio --receipt "$RUNNER_TEMP/refresh.json"
          python - <<'PY'
          import json, os
          from pathlib import Path
          receipt = json.loads((Path(os.environ['RUNNER_TEMP'])/'refresh.json').read_text())
          with open(os.environ['GITHUB_OUTPUT'], 'a') as output:
              print('changed='+str(receipt['changed']).lower(), file=output)
              print('data_only='+str(receipt.get('data_only',False)).lower(), file=output)
          with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as output:
              print('### Refresh decision\n```json\n'+json.dumps(receipt, indent=2)+'\n```', file=output)
          PY
      - name: Verify ML integrity without fitting
        if: steps.refresh.outputs.changed == 'true'
        working-directory: source
        run: python scripts/test_release.py
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        if: steps.refresh.outputs.changed == 'true'
        with:
          node-version: '22.14.0'
          package-manager-cache: false
      - name: Test, audit and build the static application
        if: steps.refresh.outputs.changed == 'true' && steps.refresh.outputs.data_only != 'true'
        working-directory: source/web
        run: |
          npm ci --ignore-scripts
          npm test
          npm run test:release
          npm audit --audit-level=moderate
          npm run build
      - name: Stage application and retained observations together
        if: steps.refresh.outputs.changed == 'true'
        working-directory: source
        run: python scripts/automated_refresh.py stage --portfolio ../portfolio --receipt "$RUNNER_TEMP/refresh.json" --archive "$RUNNER_TEMP/fourth-down.tar.gz"
      - name: Smoke test the integrated portfolio and application
        if: steps.refresh.outputs.changed == 'true' && steps.refresh.outputs.data_only != 'true'
        working-directory: source/web
        env:
          TEST_BASE_URL: http://127.0.0.1:4180/fourth-down/
          PORTFOLIO_URL: http://127.0.0.1:4180
          PORTFOLIO_CHECKOUT: ${{ github.workspace }}/portfolio
          TEST_ARTIFACT_DIR: ${{ runner.temp }}/browser-checks
        run: |
          npx playwright install --with-deps chrome
          python -m http.server 4180 --bind 127.0.0.1 --directory ../../portfolio > "$RUNNER_TEMP/http.log" 2>&1 &
          server_pid=$!
          trap 'kill "$server_pid"' EXIT
          for attempt in $(seq 1 20); do
            if curl --fail --silent http://127.0.0.1:4180/fourth-down/ > /dev/null; then break; fi
            sleep 1
          done
          npm run test:e2e -- --output="$RUNNER_TEMP/playwright"
      - name: Publish checked files through the existing Pages publisher
        working-directory: source
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python scripts/publish_forecasts.py --portfolio ../portfolio --receipt "$RUNNER_TEMP/publication.json"
          python - <<'PY'
          import os
          from pathlib import Path
          with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as output:
              print('### Publication verification\n```json\n'+(Path(os.environ['RUNNER_TEMP'])/'publication.json').read_text()+'\n```', file=output)
          PY
