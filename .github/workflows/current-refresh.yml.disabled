# INACTIVE. Owner approval required before renaming or executing. No cron is enabled.
name: Review-only current forecast refresh
on:
  workflow_dispatch:
    inputs:
      approval:
        description: Enter APPROVED-LOCAL-FORECAST-REFRESH after approval of this exact workflow
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: current-forecast-candidate
  cancel-in-progress: false
jobs:
  candidate:
    if: inputs.approval == 'APPROVED-LOCAL-FORECAST-REFRESH'
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.14.2'
      - run: python -m pip install -r requirements.txt -c requirements-lock.txt
      - run: python scripts/test_release.py
      - run: python -m ml.current
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '22.14.0'
      - run: npm ci --ignore-scripts && npm test && npm run test:release && npm run build
        working-directory: web
        env:
          VITE_BASE_PATH: /nfl-predictor/
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: current-forecast-review
          path: |
            web/public/data/current/
            data/current/
          if-no-files-found: error
          retention-days: 1
      # No commit, push, schedule or deployment. A human reviews the candidate.
