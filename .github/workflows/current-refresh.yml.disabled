# INACTIVE. Owner approval required before renaming or executing. No cron is enabled.
name: Review-only current forecast refresh
on:
  workflow_dispatch:
    inputs:
      approval:
        description: Enter APPROVED-LOCAL-FORECAST-REFRESH after approval of this exact workflow
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: current-forecast-candidate
  cancel-in-progress: false
jobs:
  candidate:
    if: inputs.approval == 'APPROVED-LOCAL-FORECAST-REFRESH'
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.14.2'
      - run: python -m pip install -r requirements.txt -c requirements-lock.txt
      - run: python scripts/test_release.py
      # Before activation, wire approved prior-bundle restoration using
      # ml.evidence_bundle import and a separately trusted receipt SHA.
      # Fail closed until original observations have been restored; a fresh
      # runner must not turn a missing cache into fake pregame availability.
      - name: Require retained source evidence before recurring refresh
        run: |
          python - <<'PY'
          import json
          from pathlib import Path
          from datetime import datetime, timezone
          from ml.current_source import current_season
          season = current_season(datetime.now(timezone.utc))
          for path in Path('web/public/data/current').glob(f'forecast-{season}-*.json'):
              artifact = json.loads(path.read_bytes())
              source = Path(f'data/current/{season}/snapshot-{artifact["snapshot_sha256"]}.json')
              if not source.is_file():
                  raise SystemExit('Missing approved observation bundle; restore verified evidence before activation')
          PY
      - run: python -m ml.refresh
      - name: Package verified portable evidence
        run: |
          python - <<'PY'
          import json
          from pathlib import Path
          from datetime import datetime, timezone
          from ml.current_source import current_season
          from ml.evidence_bundle import export_bundle
          receipt = export_bundle(current_season(datetime.now(timezone.utc)))
          Path('artifacts/evidence-bundles/latest-receipt.json').write_text(json.dumps(receipt, indent=2))
          PY
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '22.14.0'
      - run: npm ci --ignore-scripts && npm test && npm run test:release && npm run build
        working-directory: web
        env:
          VITE_BASE_PATH: /nfl-predictor/
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: current-forecast-review
          path: |
            web/public/data/current/
            web/public/data/operations/
            artifacts/evidence-bundles/
            artifacts/refresh/
          if-no-files-found: error
          retention-days: 1
      # No commit, push, schedule, context fetch, fitting or deployment.
      # One-day uploads are review delivery, not durable observation backups.
      # Recurring activation is blocked on approved restore/retention verification.
