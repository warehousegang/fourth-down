# INACTIVE: activate only after approval. Produces artifacts; never publishes the portfolio.
name: Fourth Down portfolio artifact
on:
  workflow_dispatch:
    inputs:
      refresh:
        description: Refresh current forecasts before creating the static artifact
        type: boolean
        default: true
  # Optional after approval: one refresh per day, 12:17 UTC.
  # schedule:
  #   - cron: '17 12 * * *'
permissions:
  contents: read
concurrency:
  group: fourth-down-portfolio-artifact
  cancel-in-progress: false
jobs:
  build:
    if: github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: true
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: '3.14.2'
      - run: python -m pip install -r requirements.txt -r requirements-results.txt -c requirements-lock.txt
      - run: python scripts/test_release.py
      - name: Restore, forecast and retain original observations
        if: github.event_name == 'schedule' || inputs.refresh
        run: |
          python scripts/forecast_state.py restore
          python -m ml.refresh
          python scripts/forecast_state.py save
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: '22.14.0'
          package-manager-cache: false
      - name: Verify and build the entire site
        working-directory: web
        env:
          VITE_BASE_PATH: /fourth-down/
        run: npm ci --ignore-scripts && npm test && npm run test:release && npm audit --audit-level=moderate && npm run build
      - name: Retain successful forecast history in one Git commit
        if: github.event_name == 'schedule' || inputs.refresh
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add ops/ web/public/data/current/ web/public/data/operations/
          if ! git diff --cached --quiet; then
            git commit -m 'Refresh current forecasts and retained observations'
            git push origin HEAD
          fi
      - name: Package the reviewed portfolio artifact
        run: python scripts/portfolio_artifact.py pack --generated-only --output artifacts/portfolio/fourth-down-static.tar.gz
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: fourth-down-static
          path: |
            artifacts/portfolio/fourth-down-static.tar.gz
            artifacts/portfolio/fourth-down-static.tar.gz.sha256
          if-no-files-found: error
          retention-days: 7
